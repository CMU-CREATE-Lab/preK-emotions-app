<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffaaaa" >

        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.HighlightsViewAppHeader
            android:id="@+id/appHeaderHighlights"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="65sp" />

        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.HighlightsViewDrawer
            android:id="@+id/drawerHighlights"
            android:layout_width="205sp"
            android:layout_height="0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appHeaderHighlights" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#aaffaa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/drawerHighlights"
            app:layout_constraintTop_toBottomOf="@+id/appHeaderHighlights"
            >

            <TextView
                android:id="@+id/textViewPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Placeholder"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <Button
                android:id="@+id/buttonAngry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launch Angry"
                app:layout_constraintTop_toBottomOf="@id/textViewPlaceholder"
                app:layout_constraintStart_toStartOf="@id/textViewPlaceholder"
                />
            <Button
                android:id="@+id/buttonHappy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launch Happy"
                app:layout_constraintTop_toBottomOf="@id/buttonAngry"
                app:layout_constraintStart_toStartOf="@id/buttonAngry"
                />
            <Button
                android:id="@+id/buttonSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Launch Sad"
                app:layout_constraintTop_toBottomOf="@id/buttonHappy"
                app:layout_constraintStart_toStartOf="@id/buttonAngry"
                />
            <ImageView
                android:id="@+id/testImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sheep"
                app:layout_constraintTop_toBottomOf="@id/buttonSad"
                app:layout_constraintStart_toStartOf="@id/buttonAngry"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


