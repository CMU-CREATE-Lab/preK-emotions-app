<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <!-- app:highlights_drawer_item_selected -->
    <View
        android:id="@+id/highlightView"
        style="@style/DrawerTeacherSectionHighlighted"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- app:highlights_drawer_item_text -->
    <TextView
        android:id="@+id/textView"
        style="@style/DrawerTeacherSectionText"
        android:text="Item Text"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="@+id/highlightView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/highlightView"
        app:layout_constraintTop_toTopOf="@+id/highlightView" />

</androidx.constraintlayout.widget.ConstraintLayout>
