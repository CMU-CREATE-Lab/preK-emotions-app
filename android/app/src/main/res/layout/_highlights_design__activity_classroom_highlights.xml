<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffaaaa" >

        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.HighlightsViewAppHeader
            android:id="@+id/appHeaderHighlights"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="65sp" />

        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.HighlightsViewDrawer
            android:id="@+id/drawerHighlights"
            android:layout_width="205sp"
            android:layout_height="0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appHeaderHighlights" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#EFF7FF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/drawerHighlights"
            app:layout_constraintTop_toBottomOf="@+id/appHeaderHighlights"
            >


            <Button
                android:id="@+id/buttonPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Activity"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />


            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/buttonPlaceholder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="50dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    >


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="50dp">
                        <TextView
                            android:id="@+id/editMyClassroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Classroom"
                            android:textSize="36dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <ImageView
                            android:id="@+id/editImage"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@mipmap/ic_edit_black"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toEndOf="@id/editMyClassroom"
                            app:layout_constraintTop_toTopOf="@id/editMyClassroom"
                            app:layout_constraintBottom_toBottomOf="parent"
                            />

                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#aaaaff"
                        android:layout_marginBottom="50dp"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:id="@+id/titlePatternHighlight"
                            android:layout_height="wrap_content"
                            android:text="Pattern Highlight:"
                            android:textSize="36dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Placeholder"
                            app:layout_constraintTop_toBottomOf="@id/titlePatternHighlight"
                            android:paddingBottom="100dp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/parentView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="50dp"
                        >
                        <TextView
                            android:id="@+id/titleMyClassroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Classroom"
                            android:textSize="36dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.PillToggleGroup
                            android:id="@+id/classroomToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <ImageView
                            android:id="@+id/classroomInfoImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_mindfulnest_header_info"
                            app:layout_constraintTop_toTopOf="@id/titleMyClassroom"
                            app:layout_constraintBottom_toBottomOf="@id/titleMyClassroom"
                            app:layout_constraintStart_toEndOf="@id/titleMyClassroom"
                            />

                        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.collapsible_view.ClassroomInfoCollapsibleView
                            android:id="@+id/classroomInfoCollapsibleView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/titleMyClassroom"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />

                        <GridView
                            android:id="@+id/studentsGridView"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:paddingLeft="20dp"
                            style="@style/StudentCircularViewForListStudentsInClass"
                            app:layout_constraintTop_toBottomOf="@id/classroomInfoCollapsibleView"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:stretchMode="columnWidth"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.CopingSkillsHighlightGridView
                        android:id="@+id/copingSkillsCustomView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="50dp"/>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="50dp"
                        >
                        <TextView
                            android:id="@+id/titleMonthlyOverview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Overview:"
                            android:textSize="36dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginBottom="15dp"
                            />
                        <ImageView
                            android:id="@+id/monthlyOverviewInfoImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_mindfulnest_header_info"
                            app:layout_constraintTop_toTopOf="@id/titleMonthlyOverview"
                            app:layout_constraintBottom_toBottomOf="@id/titleMonthlyOverview"
                            app:layout_constraintStart_toEndOf="@id/titleMonthlyOverview"
                            />

                        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.PillToggleGroup
                            android:id="@+id/classOverviewToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="0dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.collapsible_view.MonthlyOverviewInfoCollapsibleView
                            android:id="@+id/monthlyOverviewInfoCollapsibleView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/titleMonthlyOverview"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />

                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:orientation="horizontal"
                           android:gravity="center"
                           android:padding="0dp"
                           android:background="#FFFFFF"
                           app:layout_constraintTop_toBottomOf="@id/monthlyOverviewInfoCollapsibleView"

                           >

                           <Space
                               android:layout_width="0dp"
                               android:layout_height="0dp"
                               android:layout_weight="1" />

                           <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.ArcViewOverlay
                               android:id="@+id/monthFirst"
                               android:layout_width="110dp"
                               android:layout_height="110dp"
                               android:layout_gravity="center"
                               />

                           <Space
                               android:layout_width="0dp"
                               android:layout_height="0dp"
                               android:layout_weight="1" />

                           <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.ArcViewOverlay
                               android:id="@+id/monthPrev"
                               android:layout_width="110dp"
                               android:layout_height="110dp"
                               />

                           <Space
                               android:layout_width="0dp"
                               android:layout_height="0dp"
                               android:layout_weight="1" />

                           <org.cmucreatelab.android.flutterprek.activities.teacher_section.highlights_design.views.ArcViewOverlay
                               android:id="@+id/monthCurr"
                               android:layout_width="110dp"
                               android:layout_height="110dp"
                               />

                           <Space
                               android:layout_width="0dp"
                               android:layout_height="0dp"
                               android:layout_weight="1" />

                       </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/trashClassroomButton"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@mipmap/ic_delete_black"
                            android:layout_marginEnd="10dp" />

                        <Button
                            android:id="@+id/deleteClassroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete Classroom"
                            android:backgroundTint="@android:color/holo_red_dark"
                            app:layout_constraintStart_toEndOf="@id/trashClassroomButton"
                            />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


