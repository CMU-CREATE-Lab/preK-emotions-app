<?xml version="1.0" encoding="utf-8"?>
<!-- TODO replace background #aaa -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerHighlights"
    style="@style/DrawerTeacherSection"
    android:background="#7393C7"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drawer_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/highlightViewActiveClass"
            style="@style/DrawerTeacherSectionHighlighted"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCollapsible"
            style="@style/DrawerTeacherSectionText"
            android:text="@string/mindfulnest_header_active_class"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/highlightViewActiveClass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/highlightViewActiveClass"
            app:layout_constraintTop_toTopOf="@+id/highlightViewActiveClass" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drawer_title_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintRow1">

        <View
            android:id="@+id/highlightViewSettings"
            style="@style/DrawerTeacherSectionHighlighted"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewSettings"
            style="@style/DrawerTeacherSectionText"
            android:text="@string/mindfulnest_header_settings"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="@+id/highlightViewSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/highlightViewSettings"
            app:layout_constraintTop_toTopOf="@+id/highlightViewSettings" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tempBlock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/drawer_title_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintRow2">

        <TextView
            android:id="@+id/textViewBlock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/DrawerTeacherSectionText"
            android:text="Click the drawer to go to default ClassroomIndexActivity"
            android:textColor="#0000ff"
            android:textStyle="bold"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


