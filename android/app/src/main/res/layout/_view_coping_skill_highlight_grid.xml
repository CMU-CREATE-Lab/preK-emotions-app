<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="50dp">

    <TextView
        android:id="@+id/titleMostUsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coping Skills:"
        android:textSize="36dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id = "@+id/editCopingSkills"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_gear"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_mindfulnest_header_info"
        app:layout_constraintTop_toTopOf="@id/titleMostUsed"
        app:layout_constraintBottom_toBottomOf="@id/titleMostUsed"
        app:layout_constraintStart_toEndOf="@id/titleMostUsed" />

    <GridView
        android:id="@+id/copingSkillsGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        style="@style/CopingSkillCircularView"
        android:stretchMode="columnWidth"
        app:layout_constraintTop_toBottomOf="@id/titleMostUsed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
